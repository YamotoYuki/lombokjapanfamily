# Production backend secrets template
FLASK_ENV=production
PORT=5000
SECRET_KEY=
JWT_SECRET=
SUPABASE_JWT_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/ga4.json

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
ADMIN_CONTACT_EMAIL=

CORS_ORIGINS=https://www.example.com
RATE_LIMIT_DEFAULT=100 per minute
LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=1.0.0

# Production backend secrets template
FLASK_ENV=production
PORT=5000
SECRET_KEY=
JWT_SECRET=
SUPABASE_JWT_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Enabled automatically in production; override only to disable or retune.
YOUTUBE_AUTO_SYNC_ENABLED=
YOUTUBE_AUTO_SYNC_INTERVAL_SECONDS=3600

GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Contact mail (optional). Empty/misconfigured → inquiries still save;
# emails are skipped with [MAIL] warnings, never a failed submission.
#
# Render's free web services block outbound SMTP ports (25/465/587), so
# MAIL_PROVIDER=smtp will silently fail to send there — use MAIL_PROVIDER=resend
# (HTTPS API, not blocked) unless this service is on a paid Render plan.
MAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@lombokjapanfamily.site
ADMIN_CONTACT_EMAIL=your-team-inbox@example.com
# Reply-To on the visitor's auto-reply; defaults to ADMIN_CONTACT_EMAIL if unset.
MAIL_REPLY_TO=

# Gmail SMTP fallback — only usable on a paid Render plan (or another host
# that doesn't block outbound SMTP). Leave MAIL_PROVIDER=resend above unless
# you've confirmed SMTP actually works from this deployment.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM=your-gmail@gmail.com
ADMIN_EMAIL=

# Comma-separated allowlist, no trailing slashes. Must include every origin
# the frontend is actually served from (custom domain + any Pages preview
# domain still in use), or every /api/* request from that origin gets
# blocked by the browser's CORS check.
CORS_ORIGINS=https://lombokjapanfamily.site
RATE_LIMIT_DEFAULT=100 per minute
RATE_LIMIT_CONTACT=8 per minute
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=1.0.0

# Cloudflare Turnstile secret (pair with VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=

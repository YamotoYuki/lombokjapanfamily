# Production backend secrets template
FLASK_ENV=production
PORT=5000
SECRET_KEY=
JWT_SECRET=
SUPABASE_JWT_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Contact mail via Gmail SMTP (optional). Set real values in Render/Railway Secrets.
# Empty SMTP_* → inquiries still save; emails are skipped with [MAIL] warnings.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com
EMAIL_FROM=your-gmail@gmail.com
ADMIN_EMAIL=
ADMIN_CONTACT_EMAIL=admin@example.com
# RESEND_API_KEY=

CORS_ORIGINS=
RATE_LIMIT_DEFAULT=100 per minute
RATE_LIMIT_CONTACT=8 per minute
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=1.0.0

# Cloudflare Turnstile secret (pair with VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=

# Backend local/dev environment (DO NOT COMMIT REAL SECRETS)
FLASK_ENV=development
PORT=5000
SECRET_KEY=

# Dashboard → Settings → API → JWT Secret (must match exactly)
SUPABASE_JWT_SECRET=
JWT_SECRET=

SUPABASE_URL=
# Dashboard → Settings → API → service_role (secret). NEVER a URL like .../rest/v1/
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
# Channel ID (UC...) or @handle. Empty falls back to @lombokjapanfamily via API.
YOUTUBE_CHANNEL_ID=
# Hourly background video sync (in addition to the manual "同期" button).
# Default: enabled in production, disabled otherwise (avoids extra threads
# during pytest/local dev). Uses ~1-11 YouTube quota units per run.
YOUTUBE_AUTO_SYNC_ENABLED=
YOUTUBE_AUTO_SYNC_INTERVAL_SECONDS=3600

GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Contact mail (optional — inquiries still save if unset). SMTP works fine
# for local dev; production uses MAIL_PROVIDER=resend instead, since
# Render's free tier blocks outbound SMTP ports — see .env.production.example.
# Use a Gmail App Password for SMTP_PASSWORD. Never commit real secrets.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com
EMAIL_FROM=your-gmail@gmail.com
ADMIN_EMAIL=
ADMIN_CONTACT_EMAIL=admin@example.com
# Reply-To on the visitor's auto-reply; defaults to ADMIN_CONTACT_EMAIL if unset.
MAIL_REPLY_TO=
# RESEND_API_KEY=

CORS_ORIGINS=
RATE_LIMIT_DEFAULT=100 per minute
# Public contact form (stricter). Prefer Redis in production: RATE_LIMIT_STORAGE_URI=redis://...
RATE_LIMIT_CONTACT=8 per minute
LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=1.0.0

# Cloudflare Turnstile (Contact spam protection). Empty = skip verify (local/dev).
TURNSTILE_SECRET_KEY=

# Optional: MyMemory email raises free-tier translation quota for announcement drafts
# MYMEMORY_EMAIL=

# Optional CSP override for API responses (default: default-src 'none')
# CONTENT_SECURITY_POLICY=

WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Local only SSL workaround. Keep true in production.
SUPABASE_SSL_VERIFY=true

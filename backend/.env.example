# Backend local/dev environment (DO NOT COMMIT REAL SECRETS)
FLASK_ENV=development
PORT=5000
SECRET_KEY=development-secret-key-change-this

# Dashboard → Settings → API → JWT Secret (must match exactly)
SUPABASE_JWT_SECRET=
JWT_SECRET=

SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Settings → API → service_role (secret). NEVER a URL like .../rest/v1/
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_CONTACT_EMAIL=
MAIL_PROVIDER=smtp

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_DEFAULT=100 per minute
LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=1.0.0

WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

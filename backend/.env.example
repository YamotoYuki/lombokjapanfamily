# Backend local/dev environment (DO NOT COMMIT REAL SECRETS)
FLASK_ENV=development
PORT=5000
SECRET_KEY=

# Dashboard → Settings → API → JWT Secret (must match exactly)
SUPABASE_JWT_SECRET=
JWT_SECRET=

SUPABASE_URL=
# Dashboard → Settings → API → service_role (secret). NEVER a URL like .../rest/v1/
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
# Channel ID (UC...) or @handle. Empty falls back to @lombokjapanfamily via API.
YOUTUBE_CHANNEL_ID=

GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Contact mail via Gmail SMTP (optional — inquiries still save if unset).
# Use a Gmail App Password for SMTP_PASSWORD. Never commit real secrets.
# Production: set these in Render / Railway Secrets (not in git).
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com
EMAIL_FROM=your-gmail@gmail.com
ADMIN_EMAIL=
ADMIN_CONTACT_EMAIL=admin@example.com
# RESEND_API_KEY=

CORS_ORIGINS=
RATE_LIMIT_DEFAULT=100 per minute
# Public contact form (stricter). Prefer Redis in production: RATE_LIMIT_STORAGE_URI=redis://...
RATE_LIMIT_CONTACT=8 per minute
LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=1.0.0

# Cloudflare Turnstile (Contact spam protection). Empty = skip verify (local/dev).
TURNSTILE_SECRET_KEY=

# Optional: MyMemory email raises free-tier translation quota for announcement drafts
# MYMEMORY_EMAIL=

# Optional CSP override for API responses (default: default-src 'none')
# CONTENT_SECURITY_POLICY=

WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Local only SSL workaround. Keep true in production.
SUPABASE_SSL_VERIFY=true

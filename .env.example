# Frontend (Vite)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
VITE_SITE_URL=
# Cloudflare Turnstile site key (public). Pair with backend TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Site page images (optional). Default: temporary Unsplash stock via src/data/pageImages.ts
# Set true after placing files in public/images/site/ (see that folder's README).
# VITE_USE_LOCAL_SITE_IMAGES=true
# Or override individually:
# VITE_IMAGE_HOME_HERO=
# VITE_IMAGE_ANNOUNCEMENTS=
# VITE_IMAGE_BLOG=
# VITE_IMAGE_CONTACT=
# VITE_IMAGE_FAMILY=
# VITE_IMAGE_GALLERY=
# VITE_IMAGE_VIDEOS=

# Docker Compose host ports
FRONTEND_PORT=8080
BACKEND_PORT=5000

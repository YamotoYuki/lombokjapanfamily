# Production frontend build args / Cloudflare Workers / Vercel / Cloudflare Pages
# Set these in Cloudflare Dashboard → Settings → Variables (Build) before npm run build.
VITE_API_BASE_URL=https://lombokjapanfamily.onrender.com/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
# Canonical production origin, no trailing slash — used for canonical/OGP URLs (see SiteSeo.tsx).
VITE_SITE_URL=https://lombokjapanfamily.site
# Public Turnstile site key (must pair with Render TURNSTILE_SECRET_KEY).
# Also allow hostname: lombokjapanfamily.lombokjapanfamily.workers.dev (Pages preview URL)
VITE_TURNSTILE_SITE_KEY=
